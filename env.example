# Boris MUD - local environment configuration
# Copy to .env and edit. This file is read by the Makefile.
# Lines starting with # are ignored. Format: KEY=value (no export, no quotes).

# Deploy destination for 'make deploy' (user@host or user@host:dir)
# DEPLOY_DEST=jon@myserver.com:mud

# Override release architecture label (auto-detected from compiler triplet)
# RELEASE_ARCH=linux-arm32

# Cross-compiler and linker flags (used by make all/release/deploy)
# CC=arm-linux-gnueabihf-gcc
# LDFLAGS=-static
