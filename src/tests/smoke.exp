#!/usr/bin/expect -f
# smoke.exp : expect script for boris telnet smoke tests
#
# Usage: smoke.exp <port> <test-name>
#
# Tests:
#   menu_quit    - connect, see login menu, quit with Q
#   bad_login    - connect, attempt login with bad creds, see error
#   new_user     - create account, login, reach main menu
#   enter_game   - login, enter game world, run help, quit
#   charset_command - login, set charset, run chartest, reset
#   at_commands  - login as a wizard, exercise @chown/@grant/@revoke and
#                  their refusal paths (this test must run last: it revokes
#                  the account's own wizard flag at the end)

set timeout 10
set port [lindex $argv 0]
set test [lindex $argv 1]

log_user 0

proc fail {msg} {
	puts "FAIL: $msg"
	exit 1
}

proc pass {msg} {
	puts "PASS: $msg"
}

# connect to server
spawn -noecho telnet 127.0.0.1 $port

# every test starts by seeing the login menu
expect {
	"Login Menu" {}
	timeout { fail "$test: no login menu" }
	eof { fail "$test: connection closed before login menu" }
}
expect {
	"Choose:" {}
	timeout { fail "$test: no menu prompt" }
}

switch -- $test {
	menu_quit {
		send "Q\r"
		expect {
			eof { pass "menu_quit: connected and quit cleanly" }
			timeout { fail "menu_quit: no disconnect after Q" }
		}
	}

	bad_login {
		send "L\r"
		expect {
			"Username:" {}
			timeout { fail "bad_login: no username prompt" }
		}
		send "nosuchuser\r"
		expect {
			"Password:" {}
			timeout { fail "bad_login: no password prompt" }
		}
		send "wrongpass\r"
		expect {
			-re "Invalid|invalid|Login Menu" {}
			timeout { fail "bad_login: no invalid login response" }
		}
		# should return to login menu
		expect {
			"Choose:" {}
			timeout { fail "bad_login: no menu prompt after failure" }
		}
		send "Q\r"
		expect {
			eof { pass "bad_login: rejected bad credentials" }
			timeout { fail "bad_login: no disconnect after Q" }
		}
	}

	new_user {
		send "N\r"
		expect {
			"Username:" {}
			timeout { fail "new_user: no username prompt" }
		}
		send "testuser\r"
		expect {
			"Password:" {}
			timeout { fail "new_user: no password prompt" }
		}
		send "testpass123\r"
		expect {
			"password again:" {}
			timeout { fail "new_user: no confirm password prompt" }
		}
		send "testpass123\r"
		expect {
			"Email:" {}
			timeout { fail "new_user: no email prompt" }
		}
		send "test@test.com\r"
		# form shows a review screen, accept it
		expect {
			"accept" {}
			timeout { fail "new_user: no review screen after form" }
		}
		expect {
			"Pick:" {}
			timeout { fail "new_user: no form prompt" }
		}
		send "A\r"
		# after acceptance, expect account creation + login menu
		expect {
			-re "success|Login Menu" {}
			timeout { fail "new_user: no response after accept" }
		}
		expect {
			"Choose:" {}
			timeout {}
		}
		send "L\r"
		expect {
			"Username:" {}
			timeout { fail "new_user: no username prompt for login" }
		}
		send "testuser\r"
		expect {
			"Password:" {}
			timeout { fail "new_user: no password prompt for login" }
		}
		send "testpass123\r"
		expect {
			"Main Menu" {
				pass "new_user: created account and logged in"
			}
			-re "Invalid|invalid" {
				fail "new_user: login rejected after account creation"
			}
			timeout { fail "new_user: no main menu after login" }
		}
		# quit from main menu
		expect {
			"Choose:" {}
			timeout {}
		}
		send "Q\r"
		expect {
			eof {}
			timeout {}
		}
	}

	enter_game {
		# login with the account created by new_user
		send "L\r"
		expect {
			"Username:" {}
			timeout { fail "enter_game: no username prompt" }
		}
		send "testuser\r"
		expect {
			"Password:" {}
			timeout { fail "enter_game: no password prompt" }
		}
		send "testpass123\r"
		expect {
			"Main Menu" {}
			-re "Invalid|invalid" {
				fail "enter_game: login rejected"
			}
			timeout { fail "enter_game: no main menu after login" }
		}
		expect {
			"Choose:" {}
			timeout { fail "enter_game: no menu prompt" }
		}
		# enter the game
		send "E\r"
		expect {
			"Tower Entrance" {}
			timeout { fail "enter_game: no room description on entry" }
		}
		expect {
			"> " {}
			timeout { fail "enter_game: no command prompt" }
		}
		# test look command
		send "look\r"
		expect {
			"Tower Entrance" {}
			timeout { fail "enter_game: look did not show room" }
		}
		expect {
			"Exits:" {}
			timeout { fail "enter_game: look did not show exits" }
		}
		expect {
			"> " {}
			timeout { fail "enter_game: no prompt after look" }
		}
		# test movement -- go north
		send "n\r"
		expect {
			"Thieves District" {}
			timeout { fail "enter_game: go north did not work" }
		}
		expect {
			"> " {}
			timeout { fail "enter_game: no prompt after go north" }
		}
		# go back south
		send "south\r"
		expect {
			"Tower Entrance" {}
			timeout { fail "enter_game: go south did not work" }
		}
		expect {
			"> " {}
			timeout { fail "enter_game: no prompt after go south" }
		}
		# quit from game
		send "quit\r"
		expect {
			eof { pass "enter_game: entered game, look and movement work" }
			timeout { fail "enter_game: no disconnect after quit" }
		}
	}

	charset_command {
		# login with the account created by new_user
		send "L\r"
		expect {
			"Username:" {}
			timeout { fail "charset_command: no username prompt" }
		}
		send "testuser\r"
		expect {
			"Password:" {}
			timeout { fail "charset_command: no password prompt" }
		}
		send "testpass123\r"
		expect {
			"Main Menu" {}
			-re "Invalid|invalid" {
				fail "charset_command: login rejected"
			}
			timeout { fail "charset_command: no main menu after login" }
		}
		expect {
			"Choose:" {}
			timeout { fail "charset_command: no menu prompt" }
		}
		# enter the game
		send "E\r"
		expect {
			"> " {}
			timeout { fail "charset_command: no command prompt" }
		}
		# check default encoding
		send "charset\r"
		expect {
			"UTF-8" {}
			timeout { fail "charset_command: charset did not show default" }
		}
		expect {
			"> " {}
			timeout { fail "charset_command: no prompt after charset" }
		}
		# set to cp437
		send "charset cp437\r"
		expect {
			"Encoding set to CP437" {}
			timeout { fail "charset_command: charset cp437 failed" }
		}
		expect {
			"> " {}
			timeout { fail "charset_command: no prompt after charset set" }
		}
		# verify it stuck
		send "charset\r"
		expect {
			"CP437" {}
			timeout { fail "charset_command: encoding not showing CP437" }
		}
		expect {
			"> " {}
			timeout { fail "charset_command: no prompt after charset check" }
		}
		# run chartest to verify output is produced
		send "chartest\r"
		expect {
			"Box drawing" {}
			timeout { fail "charset_command: chartest no box drawing section" }
		}
		expect {
			"Currency" {}
			timeout { fail "charset_command: chartest no currency section" }
		}
		expect {
			"> " {}
			timeout { fail "charset_command: no prompt after chartest" }
		}
		# reset to utf8
		send "charset utf8\r"
		expect {
			"UTF-8" {}
			timeout { fail "charset_command: reset to utf8 failed" }
		}
		expect {
			"> " {}
			timeout { fail "charset_command: no prompt after reset" }
		}
		send "quit\r"
		expect {
			eof { pass "charset_command: charset and chartest commands work" }
			timeout { fail "charset_command: no disconnect after quit" }
		}
	}

	at_commands {
		# login with the account created by new_user. In the smoke config
		# newuser.flags carries the wizard bit, so this account may run the
		# admin @-commands.
		send "L\r"
		expect {
			"Username:" {}
			timeout { fail "at_commands: no username prompt" }
		}
		send "testuser\r"
		expect {
			"Password:" {}
			timeout { fail "at_commands: no password prompt" }
		}
		send "testpass123\r"
		expect {
			"Main Menu" {}
			-re "Invalid|invalid" {
				fail "at_commands: login rejected"
			}
			timeout { fail "at_commands: no main menu after login" }
		}
		expect {
			"Choose:" {}
			timeout { fail "at_commands: no menu prompt" }
		}
		# enter the game
		send "E\r"
		expect {
			"> " {}
			timeout { fail "at_commands: no command prompt" }
		}

		# @chown: assign an existing object to a seeded reserved owner.
		# chars/system is seeded at character_initialize, so no player need
		# exist for this to resolve.
		send "@chown rooms/tower-entrance chars/system\r"
		expect {
			"is now owned by chars/system" {}
			-re "Permission denied" { fail "at_commands: @chown denied to wizard" }
			timeout { fail "at_commands: @chown did not report success" }
		}
		expect {
			"> " {}
			timeout { fail "at_commands: no prompt after @chown" }
		}

		# @chown failure: the object does not exist.
		send "@chown rooms/nonesuch chars/system\r"
		expect {
			"No such object" {}
			timeout { fail "at_commands: @chown missing object not reported" }
		}
		expect {
			"> " {}
			timeout { fail "at_commands: no prompt after bad @chown object" }
		}

		# @chown failure: the owner does not exist.
		send "@chown rooms/tower-entrance chars/9999\r"
		expect {
			"No such owner" {}
			timeout { fail "at_commands: @chown missing owner not reported" }
		}
		expect {
			"> " {}
			timeout { fail "at_commands: no prompt after bad @chown owner" }
		}

		# @chown failure: the owner must be a chars/ id.
		send "@chown rooms/tower-entrance rooms/church\r"
		expect {
			"must be a character id" {}
			timeout { fail "at_commands: @chown non-char owner not rejected" }
		}
		expect {
			"> " {}
			timeout { fail "at_commands: no prompt after non-char @chown owner" }
		}

		# @grant then @revoke a flag on the account.
		send "@grant testuser x\r"
		expect {
			"Granted flag 'x' to testuser" {}
			timeout { fail "at_commands: @grant did not report success" }
		}
		expect {
			"> " {}
			timeout { fail "at_commands: no prompt after @grant" }
		}
		send "@revoke testuser x\r"
		expect {
			"Revoked flag 'x' from testuser" {}
			timeout { fail "at_commands: @revoke did not report success" }
		}
		expect {
			"> " {}
			timeout { fail "at_commands: no prompt after @revoke" }
		}

		# deny path: revoke our own wizard flag, which takes effect on the
		# live session, then confirm a gated command is now refused.
		send "@revoke testuser w\r"
		expect {
			"Revoked flag 'w' from testuser" {}
			timeout { fail "at_commands: self @revoke of wizard flag failed" }
		}
		expect {
			"> " {}
			timeout { fail "at_commands: no prompt after wizard self-revoke" }
		}
		send "@grant testuser b\r"
		expect {
			"Permission denied" {}
			"Granted" { fail "at_commands: gated command allowed after wizard revoke" }
			timeout { fail "at_commands: no permission response after revoke" }
		}
		expect {
			"> " {}
			timeout { fail "at_commands: no prompt after denied command" }
		}

		send "quit\r"
		expect {
			eof { pass "at_commands: @chown/@grant/@revoke and refusals work" }
			timeout { fail "at_commands: no disconnect after quit" }
		}
	}

	default {
		fail "unknown test: $test"
	}
}
